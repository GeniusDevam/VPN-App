<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions that upstream's manifest or its libraries add but this app never uses (audit finding B10).
         Each one is enforced absent by tools/manifest-policy.json in CI.
         - READ_EXTERNAL_STORAGE: only for importing .ovpn files from storage, which this app does not do.
         - NOT removed: RECEIVE_BOOT_COMPLETED. An earlier attempt to remove it crashed the VPN process on every connect (emulator
           run 27): upstream's keep-alive job (keepVPNAlive) is a *persisted* JobScheduler job, which Android only allows with this
           permission. The start-on-boot receiver, a separate component, is removed below; this permission alone starts nothing.
         - QUERY_ALL_PACKAGES: lets an app inventory everything installed. The split-tunnel picker only lists launchable apps,
           which the narrow <queries> entry below already makes visible.
         - ACCESS_LOCAL_NETWORK: LAN access; relays are public addresses and nothing here talks to the local network.
           (Android 17 enforces it; not testable on the Android 16 emulator, so a regression there would show only as LAN failures.) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/vpnapp_name"
        android:theme="@style/VpnAppTheme"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/vpnapp_data_extraction"
        android:networkSecurityConfig="@xml/vpnapp_network_security"
        tools:replace="android:label,android:theme,android:allowBackup"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning">

        <activity
            android:name="io.github.geniusdevam.vpnapp.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/VpnAppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="io.github.geniusdevam.vpnapp.RunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_server_selection" />
        </service>

        <service
            android:name="io.github.geniusdevam.vpnapp.QuickTileService"
            android:exported="true"
            android:icon="@drawable/vpnapp_ic_tile"
            android:label="@string/vpnapp_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Upstream components that other apps could reach (found in the built APK by tools/manifest-exports.py, finding B10).
             Removed: this app never uses upstream's external-control API (another app could ask it to connect, pause or disconnect),
             and does not start on boot. Enforced by tools/manifest-policy.json. -->
        <service android:name="de.blinkt.openvpn.api.ExternalOpenVPNService" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.GrantPermissionsActivity" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.ConfirmDialog" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.SetDefaultVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ResumeVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.PauseVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.DisconnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ConnectVPN" tools:node="remove" />
        <receiver android:name="de.blinkt.openvpn.OnBootReceiver" tools:node="remove" />
        <!-- Kept (upstream may start it with an explicit in-app intent) but no longer startable by other apps. -->
        <activity
            android:name="de.blinkt.openvpn.LaunchVPN"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- Upstream's skeleton flavour needs these stub names to exist for its own explicit intents; no other app has a reason to
             start them, so they are not exported. -->
        <activity
            android:exported="false"
            android:name=".activities.NotImplemented" />
        <activity-alias
            android:exported="false"
            android:name=".activities.LogWindow"
            android:targetActivity=".activities.NotImplemented" />
        <activity-alias
            android:exported="false"
            android:name=".activities.Req"
            android:targetActivity=".activities.NotImplemented" />
    </application>
</manifest>
