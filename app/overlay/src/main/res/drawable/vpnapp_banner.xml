<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (shown at 320x180 dp): app colour with the shield centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1F3A5F" />
        </shape>
    </item>
    <item android:drawable="@drawable/vpnapp_ic_foreground" android:gravity="center" android:width="135dp" android:height="135dp" />
</layer-list>
