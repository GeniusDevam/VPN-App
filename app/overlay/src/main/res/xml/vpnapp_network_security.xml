<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, everywhere. The VPN Gate list is fetched over HTTPS and never downgraded: an unauthenticated
         response could rewrite relay addresses and certificates, and nothing in it would reveal that. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
